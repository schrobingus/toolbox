
# Mod1 = Alt, Mod4 = Super
set $mod Mod4

font pango:Geist 9

floating_modifier $mod

# output * bg "$HOME/.config/wallpaper.jpg" fill
exec wbg -s "$HOME/.config/wallpaper.jpg"

## COMMENT OUT IF NOT ON THINKPAD!!!
# Remap Caps Lock to Control.
input "type:keyboard" {
  xkb_options ctrl:nocaps
}
# Configure the acceleration of the TrackPoint.
input "type:pointer" {
  accel_profile "flat"
  pointer_accel 0.7
}
# Disable laptop trackpad.
input "type:touchpad" {
  events disabled
}

# bindsym $mod+Return exec sh -c 'test "$ENABLE_SOFTWARE_RENDERING" = 1 && LIBGL_ALWAYS_SOFTWARE=1 exec ghostty || exec ghostty'
bindsym $mod+Return exec "foot"

bindsym $mod+space exec "bemenu-run -i -b --fn 'Geist 9' -H 24 --hp 4 --tb '#000000' --tf '#cecdc3' --fb '#000000' --ff '#cecdc3' --hb '#af3029' --hf '#000000' --sb '#af3029' --sf '#000000'"

for_window [class="mpv"] inhibit_idle fullscreen

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+b focus beginning
bindsym $mod+e focus end

bindsym $mod+Shift+Left focus output left
bindsym $mod+Shift+Right focus output right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+b move beginning
bindsym $mod+Shift+e move end

bindsym $mod+Alt+h move left nomode
bindsym $mod+Alt+j move down nomode
bindsym $mod+Alt+k move up nomode
bindsym $mod+Alt+l move right nomode
bindsym $mod+Alt+b move beginning nomode
bindsym $mod+Alt+e move end nomode

# TODO: try focus ring at some point

bindsym $mod+v set_mode h
bindsym $mod+s set_mode v

bindsym $mod+f floating toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+x focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Control+h workspace prev
bindsym $mod+Control+l workspace next

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+BackSpace reload

bindsym Mod1+F4 kill
bindsym $mod+q kill
bindsym $mod+Shift+q exec "scrollnag -t warning -m 'Really, exit?' -b 'Yes' 'scrollmsg exit'"

bindsym $mod+u resize shrink width 8 px or 8 ppt
bindsym $mod+i resize grow width 8 px or 8 ppt
bindsym $mod+Shift+u resize shrink height 8 px or 8 ppt
bindsym $mod+Shift+i resize grow height 8 px or 8 ppt

mode "sizes" {
    bindsym h resize shrink width 8 px or 8 ppt
    bindsym j resize grow height 8 px or 8 ppt
    bindsym k resize shrink height 8 px or 8 ppt
    bindsym l resize grow width 8 px or 8 ppt
    bindsym v cycle_size h next
    bindsym Shift+v cycle_size h prev
    bindsym s cycle_size v next
    bindsym Shift+s cycle_size v prev
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "sizes"

mode "align" {
    bindsym h align left
    bindsym j align down
    bindsym k align up
    bindsym l align right
    bindsym c align center
    bindsym m align middle
    bindsym r align reset
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+t mode "default"
}
bindsym $mod+t mode "align"

# TODO: look into this "fit_size" thing

mode "modes" {
    bindsym h set_mode before
    bindsym j set_mode nofocus
    bindsym k set_mode focus
    bindsym l set_mode after
    bindsym b set_mode beginning
    bindsym e set_mode end
    bindsym s set_mode center_vert
    bindsym Shift+s set_mode nocenter_vert
    bindsym v set_mode center_horiz
    bindsym Shift+v set_mode nocenter_horiz
    bindsym r set_mode reorder_auto
    bindsym Shift+r set_mode noreorder_auto
    bindsym w set_mode fitfraction
    bindsym Ctrl+w set_mode fitsplit
    bindsym Shift+w set_mode nofit
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mod+w mode "default"
}
bindsym $mod+w mode "modes"

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# Volume (FN)
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%

# Volume (Symbols)
bindsym --locked $mod+Backslash exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked $mod+Apostrophe exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked $mod+BracketLeft exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked $mod+BracketRight exec pactl set-sink-volume \@DEFAULT_SINK@ +5%

# Media (FN Only)
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# Brightness (FN Only)
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

# Brightness (Symbols)
bindsym --locked $mod+Shift+BracketLeft exec brightnessctl set 5%-
bindsym --locked $mod+Shift+BracketRight exec brightnessctl set 5%+

# Screenshot (FN Only)
bindsym Print exec grim -o "$(scrollmsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" - | wl-copy
bindsym Control+Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim -o "$(scrollmsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" ~/Pictures/grim-$(date +%Y%m%d-%H%M%S).png
bindsym Control+Shift+Print exec grim -g "$(slurp)" ~/Pictures/grim-$(date +%Y%m%d-%H%M%S).png

# Screenshot (Symbols)
bindsym $mod+Semicolon exec grim -o "$(scrollmsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" - | wl-copy
bindsym $mod+Control+Semicolon exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+Semicolon exec grim -o "$(scrollmsg -t get_outputs | jq -r '.[] | select(.focused) | .name')" ~/Pictures/grim-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+Control+Shift+Semicolon exec grim -g "$(slurp)" ~/Pictures/grim-$(date +%Y%m%d-%H%M%S).png

bar {
    status_command exec /home/brent/.config/wmstatus.sh
    position top
    mode top
    workspace_min_width 24
    status_padding 2
    strip_workspace_numbers yes
    trails_indicator no
    # TODO: submit a pr to allow the user to turn on/off certain indicators, and customize the symbols
    scroller_indicator yes

    colors {
        background #000000
        statusline #cecdc3
        separator #000000

        focused_workspace #000000 #af3029 #cecdc3
        active_workspace #000000 #6c201c #cecdc3
        inactive_workspace #000000 #6c201c #cecdc3
        urgent_workspace #000000 #bc5215 #cecdc3

        scroller #000000 #282726 #cecdc3
    }
}

# color of border, background, text, indicator, and child_border
client.focused            #af3029 #403e3c #cecdc3 #af3029 #af3029
client.focused_inactive   #282726 #403e3c #cecdc3 #282726 #282726
client.unfocused          #282726 #403e3c #cecdc3 #282726 #282726
client.urgent             #282726 #403e3c #cecdc3 #282726 #282726
client.placeholder        #282726 #403e3c #cecdc3 #282726 #282726
client.background         #282726

animations {
    enabled yes
    default yes 150 var 3 [ 0.215 0.61 0.355 1 ]
    window_open yes 100 var 3 [ 0 0 1 1 ]
    window_move yes 150 var 3 [ 0.215 0.61 0.355 1 ] off 0.05 6 [0 0.6 0.4 0 1 0 0.4 -0.6 1 -0.6]
    window_size yes 150 var 3 [ -0.35 0 0 0.5 ]
    workspace_switch yes 250 var simple [ 0.215 0.61 0.355 1 ]
    window_fullscreen yes 250 var simple [ 0.3 0.5 0.4 1 ]
    jump yes 250 var simple [ 0.215 0.61 0.355 1 ]
    layer_shell yes 150 var 3 [ 0 0 1 1 ]
    fade_in yes 150 var simple [ 0.32 0 0.67 0 ]
    fade_out yes 150 var simple [ 0.33 1 0.68 1 ]
}

default_border pixel 4
gaps inner 8
gaps outer 8

layout_default_width 0.5
layout_default_height 1.0
layout_widths [0.333 0.5 0.667 1.0]
layout_heights [0.333 0.5 0.667 1.0]
focus_wrapping no

include @sysconfdir@/scroll/config.d/*
